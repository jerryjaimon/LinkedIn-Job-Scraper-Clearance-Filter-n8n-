      "parameters": {
        "jsCode": "// NODE 1: MASTER RESUME DATA\n// Updated Projects to use 'highlights' array for bullet points\nreturn [\n  {\n    json: {\n      \"basics\": {\n        \"label\": \"MSc Cyber Security Management at University of Warwick\",\n      \n        \"location\": {\n          \"countryCode\": \"UK\"\n        },\n        \"summary\": \"Offensive security professional with over 2 years of experience at KPMG delivering high-quality security assessments for web application, mobile, and API systems. Currently advancing expertise with an MSc in Cyber Security Management at the University of Warwick. Proven ability to identify critical vulnerabilities, collaborate with teams on remediation, and build security automation tools. Eager to apply penetration testing and Red Teaming expertise to enhance the defensive and detective capabilities of an internal security team.\"\n      },\n];"
      },
