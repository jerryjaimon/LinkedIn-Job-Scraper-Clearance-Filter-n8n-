    {
      "parameters": {
        "jsCode": "// PARSE AI OUTPUT & PREP FOR ACTIONS\nconst raw = $input.first().json.output || \"{}\";\nconst ai = JSON.parse(raw.replace(/```json/g, \"\").replace(/```/g, \"\").trim());\n\n// We assume the Job Data is passed through from the initial scrape\nconst job = $input.first().json.properties || $input.first().json;\n\n// Clean Company Name\nconst company = (job.Company || job.property_company || \"Unknown\").split('\\n')[0];\n\nreturn {\n  json: {\n    // Data for Notion Update\n    Notion_ID: job.id, // Needed for update operation\n    Match_Score: ai.match_percentage || 0,\n    Clearance: ai.clearance_required || false,\n    \n    // Data for Telegram Alert (Cleaned)\n    Title: job.Title || job.property_title,\n    Company: company,\n    Link: job.Link || job.property_link,\n    Summary: ai.tech_summary || \"No summary provided.\"\n  }\n};\n"
      },
