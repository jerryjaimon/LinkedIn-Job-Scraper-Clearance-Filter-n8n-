    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// CLEAN IDs FOR MERGE\nconst json = $input.item.json;\nconst cleanID = (json.ID || \"\").split(':').pop();\nconst cleanLink = (json.Link || \"\").split('?')[0] || \"https://linkedin.com/jobs\";\n\nreturn {\n  json: {\n    Job_ID: cleanID,\n    Title: json.Title,\n    Company: json.Company,\n    Location: json.Location,\n    Link: cleanLink,\n    Posted_Date: json.Date\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2848,
        -720
      ],
      "id": "19f6d336-530f-4ece-95f5-ac91ba041e7b",
      "name": "Filter & Clean1"
    },
    {
      "parameters": {
        "jsCode": "// ⛔ FILTER DUPLICATES (FIXED FINAL LOGIC)\n// This code assumes the previous node ('Parse Basic Info' or 'Clean Data') outputs a stream of jobs.\n\nconst allScraped = $input.all();\n\n// 1. Retrieve the Blocklist from the node that ran at the start of the workflow.\nlet existingIds = [];\ntry {\n  // We try to access the data created by the 'Flatten IDs' node.\n  // The structure is assumed to be [{ json: { existing_ids: [...] } }]\n  const nodeData = $('Flatten IDs1').first() || $('Flatten IDs1').first();\n  existingIds = nodeData.json.existing_ids || [];\n} catch (e) { \n  // If the previous node (Flatten IDs) failed to run or is disconnected, treat the blocklist as empty.\n  existingIds = []; \n}\n\n// Ensure comparison is string-to-string\nexistingIds = existingIds.map(id => id.toString());\n\n// 2. Filter Logic\nconst uniqueJobs = allScraped.filter(item => {\n  // Use 'Job_ID' which is clean and available in the input stream\n  const jobId = (item.json.Job_ID || \"\").toString();\n  \n  // Only keep the item if the ID exists AND is NOT present in our existing list.\n  // This logic correctly skips jobs that were already added to Notion.\n  return jobId && jobId !== \"\" && !existingIds.includes(jobId);\n});\n\n// 3. Traffic Control (Prevents Loop Death)\n// If the list is empty (all jobs were duplicates), we output a dummy item so the loop can continue to the next search config.\nif (uniqueJobs.length === 0) {\n  return [{ json: { _isEmpty: true } }];\n}\n\nreturn uniqueJobs;"
      },
